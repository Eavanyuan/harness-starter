# 机器本地状态，提交即冲突
.ai/locks/

# deny ledger：v1 本地观测，是否入库由 Harness² 多人信号层决策
.ai/ledger/

# init 覆盖生成物时留下的原内容备份（本地可恢复即可，不入库）
.ai/backup/

# 一次性线框，评审结论已进 FS
prototypes/*.html

node_modules/
.DS_Store
.idea/

# 本地临时验证输出（正式证据在 .ai/verify，要入库）
.ai/verify/*.tmp

# 飞书项目凭据（refresh_token 等同于长期口令）。默认落 $HOME/.harness/task-loop/，
# 这里再兜一道：万一 FEISHU_OAUTH_FILE 被指到仓库内，也不许提交。
feishu-oauth.json
.harness/

# ai-review 增量缓存（键=文件内容 sha，属本机状态；结论 md 才入库）
.ai/reviews/.cache-*.json

# zcode 的文档导入缓存：原始 .docx 二进制副本（4MB 级），不是源，别一起提交。
# .zcode 下的 agents/commands/config 是产物、要入库；只有这个导入缓存目录不要。
.zcode/document-imports/
