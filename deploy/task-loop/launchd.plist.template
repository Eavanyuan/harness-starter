<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- task-loop 定时器（剖面 A/B 共用）：外部定时器 × 无状态单轮（ADR/评审定案）。
     崩溃恢复=下个 tick；休眠唤醒=下个 tick 补上；重叠执行由 CAS 认领仲裁。
     kill switch：目标仓库 .ai/task-loop/OFF 存在时每 tick 自查即停。 -->
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__SCRIPT__</string>
    <string>--once</string>
    <string>--root</string>
    <string>__ROOT__</string>
  </array>
  <key>StartInterval</key><integer>__INTERVAL__</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__LOGDIR__/task-loop.out</string>
  <key>StandardErrorPath</key><string>__LOGDIR__/task-loop.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- 凭据走环境：launchd 不继承登录 shell 的 env，必须在此显式声明 -->
    <key>GITLAB_URL</key><string>__GITLAB_URL__</string>
    <key>GITLAB_TOKEN</key><string>__GITLAB_TOKEN__</string>
    <key>FEISHU_MCP_URL</key><string>__FEISHU_MCP_URL__</string>
    <key>HARNESS_LEDGER_DIR</key><string>__LOGDIR__</string>
  </dict>
</dict>
</plist>
