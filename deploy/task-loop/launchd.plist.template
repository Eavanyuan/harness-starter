<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- task-loop 定时器（剖面 A/B 共用）：外部定时器 × 无状态单轮（ADR/评审定案）。
     崩溃恢复=下个 tick；休眠唤醒=下个 tick 补上；重叠执行由 CAS 认领仲裁。
     kill switch：目标仓库 .ai/task-loop/OFF 存在时每 tick 自查即停。

     **本文件不含任何凭据**：它会被 `launchctl print` 打到终端、也可能被贴进工单。
     token 在 $HOME/.harness/task-loop/task-loop.env（0600），由 __WRAPPER__ 读进环境；
     换 token 只改那个文件，不用重装定时器。 -->
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__WRAPPER__</string>
  </array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>StartInterval</key><integer>__INTERVAL__</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__LOGDIR__/task-loop.out</string>
  <key>StandardErrorPath</key><string>__LOGDIR__/task-loop.err</string>
</dict>
</plist>
