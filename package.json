{
  "name": "harness-starter",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "AI Coding Harness 脚手架：单一源生成 claude / zcode / deepseek 三套 Agent 产物与 hook 接线",
  "bin": {
    "harness": "scripts/harness-cli.mjs"
  },
  "files": [
    "scripts/",
    "hooks/",
    "agents/",
    "templates/",
    "guides/",
    ".skills/",
    "test/",
    ".ai/rules/",
    ".ai/state.example.json",
    ".github/workflows/",
    "harness.config.json",
    "harness.rules.json",
    "AGENTS.md",
    ".gitignore",
    "README.md"
  ],
  "scripts": {
    "setup": "bash scripts/init-harness.sh",
    "build:agents": "node scripts/build-agents.mjs",
    "build:hooks": "node scripts/build-hooks.mjs",
    "check:agents": "node scripts/build-agents.mjs --check",
    "check:hooks": "node scripts/build-hooks.mjs --check",
    "check:skills": "node scripts/check-skills.mjs",
    "resolve:skills": "node scripts/resolve-skills.mjs",
    "verify:state": "node scripts/ci-verify.mjs",
    "verify:state:local": "node scripts/ci-verify.mjs --local",
    "doctor": "node scripts/doctor.mjs",
    "test:hooks": "bash test/hooks.test.sh",
    "test:writes": "bash test/writes.test.sh",
    "test:agents": "bash test/agents.test.sh",
    "test:skills": "bash test/skills.test.sh",
    "test:evidence": "bash test/evidence.test.sh",
    "test:wiring": "bash test/wiring.test.sh",
    "test:init": "bash test/init.test.sh",
    "harness": "node scripts/harness-cli.mjs",
    "test:harness-cli": "bash test/harness-cli.test.sh",
    "gate": "npm run doctor && npm run check:skills && npm run check:agents && npm run check:hooks && npm run verify:state && npm run test:hooks && npm run test:writes && npm run test:agents && npm run test:skills && npm run test:init && npm run test:harness-cli && npm run test:evidence && npm run test:verify-run && npm run test:ledger && npm run test:completeness && npm run test:wiring && npm run test:router && npm run test:ai-review && npm run test:broker",
    "ledger:report": "node scripts/ledger-report.mjs",
    "test:verify-run": "bash test/verify-run.test.sh",
    "test:ledger": "bash test/ledger.test.sh",
    "test:completeness": "bash test/completeness.test.sh",
    "test:router": "bash test/review-router.test.sh",
    "test:ai-review": "bash test/ai-review.test.sh",
    "test:broker": "bash test/notify-broker.test.sh"
  },
  "engines": {
    "node": ">=18"
  }
}
