{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/session_start.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/guard_state.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node hooks/guard_write.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/guard_command.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
