{
  "version": "1.1",
  "project": {
    "name": "harness-starter",
    "defaultFlowTier": "M",
    "trustLevel": "L1"
  },
  "promotionDir": "docs/plans",
  "runtime": {
    "spawn_agents": "unknown",
    "shell": "unknown",
    "ask_user": "unknown",
    "note": "宿主会话的能力声明。unknown 表示没验证过——orchestrator 必须在第一段先自检（真能派子 agent 吗？真能跑命令吗？），验证后改成本会话的真实值。声明与运行时脱节的代价是整条流水线跑空：TDC 第一个任务就是没有 agent.spawn 却按 spawn 流程起手。"
  },
  "stacks": {
    "backend": {
      "dir": "backend",
      "srcGlob": "**/*.java",
      "lint": "mvn -q compile",
      "test": "mvn -q test",
      "testOne": "mvn -q test -Dtest=<name>"
    },
    "frontend": {
      "dir": "frontend",
      "srcGlob": "**/*.{ts,vue}",
      "lint": "pnpm run lint",
      "test": "pnpm run test:unit",
      "testOne": "pnpm vitest run <file>"
    }
  },
  "skills": {
    "dir": ".skills",
    "maxLines": 200,
    "requiredKeys": [
      "name",
      "stack",
      "version",
      "stage0"
    ],
    "requiredSections": [
      "## Stage 0",
      "## 硬规则",
      "## 交付"
    ],
    "extraStacks": [
      "harness"
    ],
    "note": "skill 按 applies_to 的文件 glob 选择，不是按 stack 一对一：同一 stack 可以有多份（如 frontend 与 e2e 都服务 frontend）。命中多份则全部加载。extraStacks 是技术栈之外的受管区域（harness = 门禁与生成器自身），不算 stacks。"
  },
  "agents": {
    "enabled": [
      "orchestrator",
      "requirement-analyst",
      "feature-decomposer",
      "tech-selector",
      "spec-writer",
      "interaction-prototyper",
      "spec-reviewer",
      "coder",
      "test-engineer",
      "code-reviewer",
      "retro-ledger"
    ],
    "note": "agent 启用清单（四周节奏的机械基础）：第 1 周可裁到只读子集（orchestrator + requirement-analyst / tech-selector / spec-reviewer），第 3 周再放开 coder。缺省（删掉 enabled 键）= 全部启用；orchestrator 恒在；build-agents 只生成清单内产物，writes.json / prompts INDEX 同步只含启用集。改后跑 npm run build:agents。"
  },
  "capabilityMap": {
    "fs.read": {
      "claude": [
        "Read"
      ],
      "zcode": [
        "Read"
      ],
      "deepseek": []
    },
    "fs.search": {
      "claude": [
        "Grep",
        "Glob"
      ],
      "zcode": [
        "Grep",
        "Glob"
      ],
      "deepseek": []
    },
    "fs.write": {
      "claude": [
        "Write"
      ],
      "zcode": [
        "Write"
      ],
      "deepseek": []
    },
    "fs.edit": {
      "claude": [
        "Edit"
      ],
      "zcode": [
        "Edit"
      ],
      "deepseek": []
    },
    "shell.exec": {
      "claude": [
        "Bash"
      ],
      "zcode": [
        "Bash"
      ],
      "deepseek": []
    },
    "agent.spawn": {
      "claude": [
        "Agent"
      ],
      "zcode": [
        "Agent"
      ],
      "deepseek": []
    }
  },
  "targets": {
    "claude": {
      "enabled": true,
      "mode": "subagent",
      "agentsDir": ".claude/agents",
      "commandsDir": ".claude/commands",
      "hooksFile": ".claude/settings.json",
      "hooksNote": "Claude Code 读 .claude/settings.json，格式 {hooks:{事件:[{matcher,hooks:[{type:'command',command,timeout}]}]}}"
    },
    "zcode": {
      "enabled": true,
      "mode": "subagent",
      "agentsDir": ".zcode/agents",
      "commandsDir": ".zcode/commands",
      "hooksFile": ".zcode/config.json",
      "hooksNote": "ZCode 读 <项目>/.zcode/config.json 或 ~/.zcode/cli/config.json，必须 hooks.enabled=true；事件在 hooks.events 下，钩子形态为 {type:'process',command,args}。工作区 hook 属于会执行本地代码的配置，首次运行需在 ZCode 里确认信任，未确认前只有 CI 兜底。"
    },
    "deepseek": {
      "enabled": true,
      "mode": "prompt-only",
      "agentsDir": "prompts/agents",
      "commandsDir": "prompts/commands",
      "hooksFile": null,
      "notes": "DeepSeek 无 subagent 能力，降级为可复制的独立 prompt。接法二选一：① ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic claude，此时直接复用 claude 产物（含 hook）；② 独立 CLI/纯 API，用 prompts/ 下文件人工或脚本拼进上下文——此路径**没有任何 hook**，只有 CI 兜底。"
    }
  },
  "hooks": {
    "manifest": "hooks/hooks.manifest.json",
    "note": "hook 接线只有这一份源，build-hooks.mjs 生成各 CLI 的配置文件。手改 .claude/settings.json / .zcode/config.json 会在下次 build 被覆盖（guard_write 直接拒）。"
  },
  "modelTiers": [
    {
      "id": "strong",
      "label": "高能力模型",
      "agents": [
        "claude-*",
        "deepseek-v4*",
        "glm-4.6*"
      ],
      "scaffold": "light",
      "note": "豁免流程脚手架：SessionStart 不注入逐任务 TODO 提醒（session_start.mjs 按 scaffold 分流输出）；技能加载与 verify 证据链不豁免"
    },
    {
      "id": "standard",
      "label": "常规模型",
      "agents": [
        "*"
      ],
      "scaffold": "full",
      "note": "全量脚手架"
    }
  ],
  "gates": {
    "requireVerifyLog": true,
    "verifyFreshnessHours": 72,
    "verifyFreshnessGraceSec": 120,
    "blockedCommands": [
      {
        "pattern": "rm\\s+-[A-Za-z]*r[A-Za-z]*f[A-Za-z]*\\s+(/|~|\\$HOME|\\.\\.)(?!\\w)",
        "hint": "删根目录/家目录/上跳目录没有等价的安全写法。要清理就写明确的相对路径，或让人手工执行"
      },
      {
        "pattern": "rm\\s+-[A-Za-z]*f[A-Za-z]*r[A-Za-z]*\\s+(/|~|\\$HOME|\\.\\.)(?!\\w)",
        "hint": "同上：递归强删根/home/父目录一律拦。清理工作树用 git clean 并先跑 --dry-run"
      },
      {
        "pattern": "rm\\s+(-[A-Za-z]+\\s+){2,}(/|~|\\$HOME)(?!\\w)",
        "hint": "拆开写的 -r -f 绕过不了规则。目标路径必须落在仓库内且写全"
      },
      {
        "pattern": "git\\s+push(?!\\s+--force-with-lease)[^|;&]*?\\s\\+\\S+",
        "hint": "用 +refspec 强推等于改写远端历史。改用 --force-with-lease，或推新分支"
      },
      {
        "pattern": "git\\s+push\\s+--force(?!-with-lease)",
        "hint": "改用 --force-with-lease：别人推过新提交时会被拒绝，不至于覆盖他人的工作"
      },
      {
        "pattern": "git\\s+push\\s+-f\\b",
        "hint": "-f 是 --force 的简写，同样拦。改用 --force-with-lease"
      },
      {
        "pattern": "--no-verify",
        "hint": "跳过 hook 等于绕过全部门禁。hook 报错就修被报的问题，不要跳过它"
      },
      {
        "pattern": "-DskipTests(?!\\x3dfalse)\\b",
        "hint": "跳过测试没有合法等价形式：要么修实现，要么修测试。例外：-DskipTests=false 是显式打开测试（模块默认 skipTests=true 时必须带它），放行。确需临时跳过请在 PR 说明理由"
      },
      {
        "pattern": "-Dmaven\\.test\\.skip(?:\\.tests)?\\s*=\\s*(?!false)",
        "hint": "maven.test.skip 连编译都跳过，比 -DskipTests 更隐蔽。修测试，不要关掉它（=false 是显式打开，放行）"
      },
      {
        "pattern": "--passWithNoTests\\b",
        "hint": "零测试通过不算验证。补测试，或明确说明该模块本无测试并留 verify 记录"
      },
      {
        "pattern": "\\b(?:curl|wget)\\b[^|]*\\|\\s*(?:sudo\\s+|env\\s+)*(?:ba|z|da|k)?sh\\b",
        "hint": "管道执行远程脚本不可审计。先下载、读一遍、确认来源与校验和，再本地执行"
      },
      {
        "pattern": "\\b(?:curl|wget)\\b[^|]*\\|\\s*(?:sudo\\s+|env\\s+)*(?:python[0-9.]*|perl|node|ruby)\\b",
        "hint": "同上：管道进解释器。下载到文件、审查后再执行"
      },
      {
        "pattern": "DROP\\s+(TABLE|DATABASE)",
        "hint": "DDL 用 db/<日期>/ 下的增量 migration，不在会话里直接执行破坏性语句"
      },
      {
        "pattern": "TRUNCATE\\s+",
        "hint": "清表属数据变更，走 migration 或让人执行；会话内用带 WHERE 的 DELETE 并先备份"
      },
      {
        "pattern": "kubectl\\s+delete",
        "hint": "删生产资源属环境变更，交给人做；本地调试用独立命名空间"
      }
    ],
    "sensitiveRead": [
      "\\.env$",
      "\\.env\\.(?!example$)",
      "\\.pem$",
      "\\.key$",
      "id_rsa",
      "credentials",
      "\\.p12$"
    ],
    "writeGuards": {
      "note": "三类写入拦截，判据是路径而非 agent 身份——CLI 的 PreToolUse 载荷里没有 agent 名，硬做身份校验只会变成自欺。generated 手改必被覆盖；protected 是考卷区，改它需人工放行；sensitive 一律拒（Exempt 里的示例文件除外，否则门禁会把唯一合法的出路也堵死）。已知边界：agents 的 writes 字段是交接契约，不是运行时门禁——声明了窄 writes 的 agent（含只写文档的）在运行时仍可写任何未受保护路径，如业务源码。这道残余风险的兜底是 CR 与 .ai/writes.json 的 CI diff，不是 hook；要真正收紧只能裁 capabilities（生成期裁工具集）或进程级沙箱。",
      "generated": [
        ".claude/agents/**",
        ".claude/commands/**",
        ".claude/settings.json",
        ".zcode/agents/**",
        ".zcode/commands/**",
        ".zcode/config.json",
        "prompts/agents/**",
        "prompts/commands/**",
        "prompts/INDEX.md",
        ".ai/writes.json"
      ],
      "protected": [
        "hooks/**",
        "harness.config.json",
        "agents/**",
        "templates/**",
        ".github/**",
        ".git/**",
        "package.json"
      ],
      "sensitive": [
        "**/.env",
        "**/.env.*",
        "**/*.pem",
        "**/*.key",
        "**/id_rsa*",
        "**/credentials*"
      ],
      "sensitiveExempt": [
        "**/.env.example",
        "**/.env.sample",
        "**/.env.template"
      ]
    },
    "shell": {
      "note": "Bash 通道的路径判据。state/evidence 是仓库目录约定（本文件），命令词表在 hooks/lib/shell.mjs（那是 shell 知识，不是策略）。",
      "stateGlob": ".ai/tasks/*/state.json",
      "evidenceGlob": ".ai/verify/**"
    },
    "extraSourceGlobs": [
      "hooks/**/*.{mjs,sh}",
      "scripts/**/*.{mjs,sh}",
      "templates/**"
    ],
    "staleTaskDays": 3,
    "retroCheckFromDate": "2026-11-11"
  },
  "projects": [
    {
      "dir": "../TDasset",
      "srcGlob": "tda-server/**/src/main/java/**/*.java",
      "lint": "cd ../TDasset && mvn -q -pl tda-server validate",
      "test": "cd ../TDasset && mvn -pl tda-server test -DskipTests=false -Dskip.tests=false",
      "testOne": "cd ../TDasset && mvn -pl tda-server test -DskipTests=false -Dskip.tests=false -Dtest=<name>",
      "id": "backend"
    },
    {
      "id": "frontend",
      "dir": "../TDasset",
      "srcGlob": "frontend/src/**/*.{ts,vue}",
      "lint": "cd ../TDasset && pnpm --dir frontend run lint",
      "test": "cd ../TDasset && pnpm --dir frontend run test:unit",
      "testOne": "cd ../TDasset && pnpm --dir frontend exec vitest run <file>"
    }
  ],
  "notes": {
    "tdasset_sidecar": "TDasset 旁挂（2026-11-14）：harness 文件不进 TDasset 仓（用户指令）；代码仓在 ../TDasset，命令经 cd 过去跑；test/testOne 必须双开 skipTests=false（TDasset 根 pom 与 tda-server 是两个独立跳过属性）。"
  }
}