{
  "version": "1.1",
  "project": {
    "name": "harness-starter",
    "defaultFlowTier": "M",
    "trustLevel": "L1"
  },
  "stacks": {
    "backend": {
      "dir": "backend",
      "srcGlob": "**/*.java",
      "lint": "mvn -q -DskipTests compile",
      "test": "mvn -q test",
      "testOne": "mvn -q test -Dtest=<name>"
    },
    "frontend": {
      "dir": "frontend",
      "srcGlob": "**/*.{ts,vue}",
      "lint": "pnpm run lint",
      "test": "pnpm run test:unit",
      "testOne": "pnpm vitest run <file>"
    }
  },
  "skills": {
    "dir": ".skills",
    "maxLines": 200,
    "requiredKeys": ["name", "stack", "version", "stage0"],
    "requiredSections": ["## Stage 0", "## 硬规则", "## 交付"],
    "extraStacks": ["harness"],
    "note": "skill 按 applies_to 的文件 glob 选择，不是按 stack 一对一：同一 stack 可以有多份（如 frontend 与 e2e 都服务 frontend）。命中多份则全部加载。extraStacks 是技术栈之外的受管区域（harness = 门禁与生成器自身），不算 stacks。"
  },
  "capabilityMap": {
    "fs.read": {
      "claude": ["Read"],
      "zcode": ["Read"],
      "deepseek": []
    },
    "fs.search": {
      "claude": ["Grep", "Glob"],
      "zcode": ["Grep", "Glob"],
      "deepseek": []
    },
    "fs.write": {
      "claude": ["Write"],
      "zcode": ["Write"],
      "deepseek": []
    },
    "fs.edit": {
      "claude": ["Edit"],
      "zcode": ["Edit"],
      "deepseek": []
    },
    "shell.exec": {
      "claude": ["Bash"],
      "zcode": ["Bash"],
      "deepseek": []
    },
    "agent.spawn": {
      "claude": ["Agent"],
      "zcode": ["Agent"],
      "deepseek": []
    }
  },
  "targets": {
    "claude": {
      "enabled": true,
      "mode": "subagent",
      "agentsDir": ".claude/agents",
      "commandsDir": ".claude/commands",
      "hooksFile": ".claude/settings.json",
      "hooksNote": "Claude Code 读 .claude/settings.json，格式 {hooks:{事件:[{matcher,hooks:[{type:'command',command,timeout}]}]}}"
    },
    "zcode": {
      "enabled": true,
      "mode": "subagent",
      "agentsDir": ".zcode/agents",
      "commandsDir": ".zcode/commands",
      "hooksFile": ".zcode/config.json",
      "hooksNote": "ZCode 读 <项目>/.zcode/config.json 或 ~/.zcode/cli/config.json，必须 hooks.enabled=true；事件在 hooks.events 下，钩子形态为 {type:'process',command,args}。工作区 hook 属于会执行本地代码的配置，首次运行需在 ZCode 里确认信任，未确认前只有 CI 兜底。"
    },
    "deepseek": {
      "enabled": true,
      "mode": "prompt-only",
      "agentsDir": "prompts/agents",
      "commandsDir": "prompts/commands",
      "hooksFile": null,
      "notes": "DeepSeek 无 subagent 能力，降级为可复制的独立 prompt。接法二选一：① ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic claude，此时直接复用 claude 产物（含 hook）；② 独立 CLI/纯 API，用 prompts/ 下文件人工或脚本拼进上下文——此路径**没有任何 hook**，只有 CI 兜底。"
    }
  },
  "hooks": {
    "manifest": "hooks/hooks.manifest.json",
    "note": "hook 接线只有这一份源，build-hooks.mjs 生成各 CLI 的配置文件。手改 .claude/settings.json / .zcode/config.json 会在下次 build 被覆盖（guard_write 直接拒）。"
  },
  "modelTiers": [
    {
      "id": "strong",
      "label": "高能力模型",
      "agents": ["claude-*", "deepseek-v4*", "glm-4.6*"],
      "scaffold": "light",
      "note": "豁免流程脚手架（逐 TODO 提醒、分级提示），但技能加载与 verify 证据链不豁免"
    },
    {
      "id": "standard",
      "label": "常规模型",
      "agents": ["*"],
      "scaffold": "full",
      "note": "全量脚手架"
    }
  ],
  "gates": {
    "requireVerifyLog": true,
    "verifyFreshnessHours": 72,
    "blockedCommands": [
      "rm\\s+-[A-Za-z]*r[A-Za-z]*f[A-Za-z]*\\s+(/|~|\\$HOME|\\.\\.)(?!\\w)",
      "rm\\s+-[A-Za-z]*f[A-Za-z]*r[A-Za-z]*\\s+(/|~|\\$HOME|\\.\\.)(?!\\w)",
      "rm\\s+(-[A-Za-z]+\\s+){2,}(/|~|\\$HOME)(?!\\w)",
      "git\\s+push(?!\\s+--force-with-lease)[^|;&]*?\\s\\+\\S+",
      "git\\s+push\\s+--force(?!-with-lease)",
      "git\\s+push\\s+-f\\b",
      "--no-verify",
      "\\b(?:curl|wget)\\b[^|]*\\|\\s*(?:ba|z|da)?sh\\b",
      "\\b(?:curl|wget)\\b[^|]*\\|\\s*(?:python|perl|node)\\b",
      "DROP\\s+(TABLE|DATABASE)",
      "TRUNCATE\\s+",
      "kubectl\\s+delete"
    ],
    "sensitiveRead": [
      "\\.env$",
      "\\.env\\.(?!example$)",
      "\\.pem$",
      "\\.key$",
      "id_rsa",
      "credentials",
      "\\.p12$"
    ],
    "writeGuards": {
      "note": "三类写入拦截，判据是路径而非 agent 身份——CLI 的 PreToolUse 载荷里没有 agent 名，硬做身份校验只会变成自欺。generated 手改必被覆盖；protected 是考卷区，改它需人工放行；sensitive 一律拒（Exempt 里的示例文件除外，否则门禁会把唯一合法的出路也堵死）。",
      "generated": [
        ".claude/agents/**",
        ".claude/commands/**",
        ".claude/settings.json",
        ".zcode/agents/**",
        ".zcode/commands/**",
        ".zcode/config.json",
        "prompts/agents/**",
        "prompts/commands/**",
        "prompts/INDEX.md",
        ".ai/writes.json"
      ],
      "protected": [
        "hooks/**",
        "harness.config.json",
        "agents/**",
        "templates/**",
        ".github/**",
        ".git/**",
        "package.json"
      ],
      "sensitive": [
        "**/.env",
        "**/.env.*",
        "**/*.pem",
        "**/*.key",
        "**/id_rsa*",
        "**/credentials*"
      ],
      "sensitiveExempt": ["**/.env.example", "**/.env.sample", "**/.env.template"]
    }
  }
}
